# Makefile for uClibc-ng
# Licensed under the LGPL v2.1 or later, see the file COPYING.LIB in this tarball.

# The FPU registers hold the environment only when the FPU does all the
# arithmetic.  With fpus or fpud gcc leaves double operations or divisions to
# libgcc's fp-bit, which raises no flags and ignores the rounding mode, so
# anything short of fpud_div takes the generic fenv from libm/Makefile.in.
ifeq ($(UCLIBC_HAS_FENV),y)
ifeq ($(call libm_cc_defines,__ARC_FPU_DP_DIV__),1)
libm_ARCH_SRC:=$(wildcard $(libm_ARCH_DIR)/*.c)
libm_ARCH_OBJ:=$(patsubst $(libm_ARCH_DIR)/%.c,$(libm_ARCH_OUT)/%.o,$(libm_ARCH_SRC))
endif
endif

libm_ARCH_OBJS:=$(libm_ARCH_OBJ)

ifeq ($(DOPIC),y)
libm-a-y+=$(libm_ARCH_OBJS:.o=.os)
else
libm-a-y+=$(libm_ARCH_OBJS)
endif
libm-so-y+=$(libm_ARCH_OBJS:.o=.os)
