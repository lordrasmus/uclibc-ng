# Makefile for uClibc-ng
# Licensed under the LGPL v2.1 or later, see the file COPYING.LIB in this tarball.

# Only an ARCv2 FPU has the registers; without one (arc700, or ARC HS built
# without FPU) libm/Makefile.in takes the generic fenv, as glibc's nofpu does.
ifeq ($(UCLIBC_HAS_FENV),y)
ifneq ($(call libm_cc_defines,__ARC_FPU_SP__)$(call libm_cc_defines,__ARC_FPU_DP__),00)
libm_ARCH_SRC:=$(wildcard $(libm_ARCH_DIR)/*.c)
libm_ARCH_OBJ:=$(patsubst $(libm_ARCH_DIR)/%.c,$(libm_ARCH_OUT)/%.o,$(libm_ARCH_SRC))
endif
endif

libm_ARCH_OBJS:=$(libm_ARCH_OBJ)

ifeq ($(DOPIC),y)
libm-a-y+=$(libm_ARCH_OBJS:.o=.os)
else
libm-a-y+=$(libm_ARCH_OBJS)
endif
libm-so-y+=$(libm_ARCH_OBJS:.o=.os)
