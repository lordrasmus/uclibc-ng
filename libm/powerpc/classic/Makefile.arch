# Soft-float takes the fenv of libm/Makefile.in; bits/fenv.h matches.
ifeq ($(UCLIBC_HAS_FENV),y)
ifeq ($(call libm_cc_defines,_SOFT_FLOAT),0)
libm_ARCH_SRC:=$(wildcard $(libm_SUBARCH_DIR)/*.c)
libm_ARCH_OBJ:=$(patsubst $(libm_SUBARCH_DIR)/%.c,$(libm_SUBARCH_OUT)/%.o,$(libm_ARCH_SRC))
endif
endif

libm_ARCH_OBJS:=$(libm_ARCH_OBJ)

ifeq ($(DOPIC),y)
libm-a-y+=$(libm_ARCH_OBJS:.o=.os)
else
libm-a-y+=$(libm_ARCH_OBJS)
endif
libm-so-y+=$(libm_ARCH_OBJS:.o=.os)
